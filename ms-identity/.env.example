# ============================================
# ms-identity 身份管理服务配置文件示例
# ============================================
# 复制此文件为 .env 并根据实际情况修改配置
# 配置项命名规则：使用双下划线 __ 分隔层级，例如 APP__SERVER__ADDR

# ============================================
# 服务器配置
# ============================================
APP__SERVER__ADDR=0.0.0.0
APP__SERVER__PORT=30001

# ============================================
# 日志配置
# ============================================
# 日志级别：trace, debug, info, warn, error
APP__LOG__LEVEL=info

# ============================================
# MySQL 数据库配置
# ============================================
APP__DATABASE__URL=mysql://root:your_password@localhost:3306/ms_identity
APP__DATABASE__MAX_CONNECTIONS=100
APP__DATABASE__MIN_CONNECTIONS=10

# ============================================
# Redis 配置（可选）
# ============================================
APP__REDIS__URL=redis://127.0.0.1:6379
APP__REDIS__PASSWORD=your_redis_password
APP__REDIS__POOL_SIZE=10

# ============================================
# Nacos 服务注册与发现配置（可选）
# ============================================
APP__NACOS__SERVER_ADDRS=["http://127.0.0.1:8848"]
APP__NACOS__NAMESPACE=your_nacos_namespace_id
APP__NACOS__SERVICE_NAME=ms-identity
# 订阅的服务列表（用于服务发现）
APP__NACOS__SUBSCRIBE_SERVICES=["ms-auth"]

# ============================================
# JWT Token 配置
# ============================================
# JWT 密钥（生产环境请使用足够长度的随机密钥）
APP__JWT__SECRET=your-jwt-secret-key-change-in-production

# Access Token 过期时间（秒），默认 86400（24小时）
APP__IDENTITY__JWT__ACCESS_TOKEN_EXPIRE=86400

# Refresh Token 过期时间（秒），默认 604800（7天）
APP__IDENTITY__JWT__REFRESH_TOKEN_EXPIRE=604800

# ============================================
# Session 配置
# ============================================
# Session 过期时间（秒），默认 86400（24小时）
APP__IDENTITY__SESSION__EXPIRE=86400

# ============================================
# 密码配置
# ============================================
# 密码最小长度，默认 8
APP__IDENTITY__PASSWORD__MIN_LENGTH=8
