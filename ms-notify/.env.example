# ms-notify Docker 环境变量模板
# 复制此文件为 .env.docker 并填入实际值
# cp .env.example .env.docker

# ===== 服务器配置 =====
APP__SERVER__ADDR=0.0.0.0
APP__SERVER__PORT=30104

# ===== 日志配置 =====
APP__LOG__LEVEL=info

# ===== Kafka =====
APP__KAFKA__BROKERS=host.docker.internal:9092

# ===== Nacos =====
APP__NACOS__SERVER_ADDRS=host.docker.internal:8848
APP__NACOS__SERVICE_NAME=ms-notify

# ===== 邮件配置 =====
APP__NOTIFY__EMAIL__SMTP_SERVER=smtp.example.com
APP__NOTIFY__EMAIL__SMTP_USER=your-email@example.com
APP__NOTIFY__EMAIL__SMTP_PASS=your-smtp-password
APP__NOTIFY__EMAIL__SMTP_PORT=587

# ===== 短信配置（阿里云） =====
APP__NOTIFY__SMS__ENDPOINT=https://dysmsapi.aliyuncs.com
APP__NOTIFY__SMS__ACCESS_KEY_ID=your-access-key-id
APP__NOTIFY__SMS__ACCESS_KEY_SECRET=your-access-key-secret
APP__NOTIFY__SMS__SIGN_NAME=your-sign-name
APP__NOTIFY__SMS__TEMPLATE_CODE=SMS_000000000

# ===== 飞书配置 =====
APP__NOTIFY__FEISHU__WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-id

# ===== 钉钉配置 =====
APP__NOTIFY__DINGDING__WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=your-access-token
APP__NOTIFY__DINGDING__SECRET=your-dingding-secret

# ===== 企业微信配置 =====
APP__NOTIFY__WECHAT__WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-key

# ===== APNs 推送配置 =====
# .p8 私钥文件路径 (相对于项目根目录或绝对路径)
APP__NOTIFY__APNS__P8_CERT_PATH=certs/AuthKey_XXXXXXXXXX.p8
# 苹果团队 ID
APP__NOTIFY__APNS__TEAM_ID=XXXXXXXXXX
# 密钥 ID
APP__NOTIFY__APNS__KEY_ID=XXXXXXXXXX
# App Bundle ID
APP__NOTIFY__APNS__TOPIC=com.example.app

# ===== FCM 推送配置 =====
# Service Account JSON 文件路径
APP__NOTIFY__FCM__SERVICE_ACCOUNT_JSON_PATH=certs/firebase-service-account.json
# GCP Project ID
APP__NOTIFY__FCM__PROJECT_ID=your-project-id
