# ===== 服务器配置 =====
APP__SERVER__ADDR=127.0.0.1
APP__SERVER__PORT=30003

# ===== 日志配置 =====
APP__LOG__LEVEL=info

# ===== OSS 配置 =====
OSS__PROVIDER=rustfs
OSS__ENDPOINT=http://127.0.0.1:9000
OSS__REGION=us-east-1
OSS__ACCESS_KEY=your_access_key_here
OSS__SECRET_KEY=your_secret_key_here
OSS__DEFAULT_BUCKET=public
OSS__PUBLIC_ENDPOINT=http://localhost:9000
OSS__PRESIGN_EXPIRES_SECS=3600

# ===== MySQL =====
APP__DATABASE__URL=mysql://root:your_db_password@127.0.0.1:3306/ms_oss
APP__DATABASE__MAX_CONNECTIONS=50
APP__DATABASE__MIN_CONNECTIONS=5

# ===== Redis =====
APP__REDIS__URL=redis://127.0.0.1:6379
APP__REDIS__PASSWORD=your_redis_password
APP__REDIS__POOL_SIZE=10

# ===== Nacos =====
APP__NACOS__SERVER_ADDRS=127.0.0.1:8848
APP__NACOS__SERVICE_NAME=ms-oss
APP__NACOS__NAMESPACE=your_nacos_namespace_id

# ===== Kafka =====
APP__KAFKA__BROKERS=127.0.0.1:9092
