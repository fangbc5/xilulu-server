# 简化版 Dockerfile - 使用本地构建的二进制文件
# 使用方法：
# 1. 本地构建：cargo build --release -p ms-oss
# 2. 构建镜像：docker build -f ms-oss/Dockerfile.local -t ms-oss .
#    （在 workspace 根目录执行）

FROM gcr.io/distroless/cc-debian12

# 从本地复制已编译的二进制文件
COPY target/release/ms-oss /app/ms-oss

# 复制 SSL 根证书（本地构建环境通常已包含）
COPY --from=rust:1.88-slim /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt

WORKDIR /app

EXPOSE 30003

ENV APP__SERVER__ADDR=0.0.0.0
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

ENTRYPOINT ["/app/ms-oss"]
