# ===== 服务器配置 =====
APP__SERVER__ADDR=0.0.0.0
APP__SERVER__PORT=30102

# ===== 日志配置 =====
APP__LOG__LEVEL=info

# ===== MySQL =====
APP__DATABASE__URL=mysql://root:your_password@localhost:3306/ms_im
APP__DATABASE__MAX_CONNECTIONS=100
APP__DATABASE__MIN_CONNECTIONS=10

# ===== Redis =====
APP__REDIS__URL=redis://127.0.0.1:6379
APP__REDIS__PASSWORD=your_redis_password
APP__REDIS__POOL_SIZE=10

# ===== Kafka =====
APP__KAFKA__BROKERS=localhost:9092

# ===== Nacos =====
APP__NACOS__SERVER_ADDRS=localhost:8848
APP__NACOS__SERVICE_NAME=ms-im
APP__NACOS__NAMESPACE=your_nacos_namespace_id
APP__NACOS__SUBSCRIBE_SERVICES=["ms-identity"]
