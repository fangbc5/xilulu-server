# ms-media-processor 环境变量模板
# 复制此文件为 .env 用于本地开发，或为 .env.docker 用于 Docker 部署
# cp .env.example .env

# ===== 服务器配置 =====
APP__SERVER__ADDR=0.0.0.0
APP__SERVER__PORT=30105

# ===== 日志配置 =====
APP__LOG__LEVEL=info

# ===== 数据库配置 =====
APP__DATABASE__MYSQL__URL=mysql://root:root@127.0.0.1:3306/fbc_media
APP__DATABASE__MYSQL__MAX_CONNECTIONS=10

# ===== Redis 配置 =====
APP__REDIS__URL=redis://127.0.0.1:6379

# ===== Kafka 配置 =====
APP__KAFKA__BROKERS=127.0.0.1:9092

# ===== Nacos 配置 =====
APP__NACOS__SERVER_ADDRS=127.0.0.1:8848
APP__NACOS__SERVICE_NAME=ms-media-processor
APP__NACOS__NAMESPACE=your-namespace-id

# ===== S3/MinIO 配置（对象存储） =====
OSS__ENDPOINT=http://127.0.0.1:9000
OSS__PUBLIC_ENDPOINT=http://127.0.0.1:9000
OSS__REGION=us-east-1
OSS__ACCESS_KEY=minioadmin
OSS__SECRET_KEY=minioadmin

# ===== FFmpeg 配置（可选） =====
# 临时工作目录，处理完自动清理
MEDIA_WORK_DIR=/tmp/media_work
