# ===== 服务器配置 =====
APP__SERVER__ADDR=127.0.0.1
APP__SERVER__PORT=30106

# ===== 日志配置 =====
APP__LOG__LEVEL=info,ms_content=debug

# ===== MySQL =====
APP__DATABASE__URL=mysql://root:password@127.0.0.1:3306/ms_content
APP__DATABASE__MAX_CONNECTIONS=10
APP__DATABASE__MIN_CONNECTIONS=5

# ===== Redis =====
APP__REDIS__URL=redis://127.0.0.1:6379
APP__REDIS__PASSWORD=your_password
APP__REDIS__POOL_SIZE=10

# ===== Nacos =====
APP__NACOS__SERVER_ADDRS=127.0.0.1:8848
APP__NACOS__SERVICE_NAME=ms-content
APP__NACOS__NAMESPACE=

# ===== Meilisearch =====
APP__CONTENT__MEILISEARCH_URL=http://127.0.0.1:7700
APP__CONTENT__MEILISEARCH_API_KEY=<your-meilisearch-master-key>

# ===== XXL-JOB / Ratchjob =====
APP__CONTENT__XXL_ADMIN_ADDR=http://127.0.0.1:8725/xxl-job-admin
APP__CONTENT__XXL_ACCESS_TOKEN=<your-access-token>
APP__CONTENT__XXL_EXECUTOR_PORT=31106
