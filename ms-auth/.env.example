# ===== 服务器配置 =====
APP__SERVER__ADDR=0.0.0.0
APP__SERVER__PORT=30002

# ===== 日志配置 =====
APP__LOG__LEVEL=info

# ===== Redis =====
APP__REDIS__URL=redis://host.docker.internal:6379
APP__REDIS__PASSWORD=your_redis_password
APP__REDIS__POOL_SIZE=10
# ===== Auth 配置 =====
APP__AUTH__JWT_SECRET=your_jwt_secret_key
APP__AUTH__ACCESS_TOKEN_TIMEOUT=900
APP__AUTH__REFRESH_TOKEN_TIMEOUT=604800

# ===== Kafka =====
APP__KAFKA__BROKERS=host.docker.internal:9092

# ===== Nacos =====
APP__NACOS__SERVER_ADDRS=host.docker.internal:8848
APP__NACOS__SERVICE_NAME=ms-auth
APP__NACOS__NAMESPACE=your_nacos_namespace_id
APP__NACOS__SUBSCRIBE_SERVICES=["ms-identity"]

# ===== AuthConfig =====
APP__AUTH__ENABLE_CAPTCHA_VERIFICATION=true
